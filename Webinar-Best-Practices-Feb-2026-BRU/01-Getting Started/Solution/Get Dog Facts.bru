meta {
  name: Get Dog Facts
  type: http
  seq: 2
}

get {
  url: {{dogApiUrl}}/facts?limit=5
  body: none
  auth: none
}

params:query {
  limit: 5
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  # Get Dog Facts 🐕
  
  Fetches a random dog fact from the Dog API.
  
  Notice how the response is structured JSON — Bruno auto-formats it for you.
  
  **Try it:** Look at the response body. Each fact has an `id`, `type`, and `attributes.body`.
}
