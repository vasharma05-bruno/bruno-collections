  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  ~username: 
  ~password: 
}

assert {
  res.status: eq 200
  res.body.token: isString
}

script:post-response {
  // Set body to the response body
  const body = 
  
  // Set the bearer token value
  if (body && body.token) {
    bru.setVar("bearerToken", );
